{
  "name": "casino-infra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint frontend/src infra/lib infra/bin --quiet",
    "test": "vitest run && node lambdas/websocket/blackjack.test.js",
    "test:sos": "vitest run frontend/src/games/squareofshadows lambdas/websocket/sos.test.js lambdas/websocket/sos.transport.test.js",
    "test:sos:smoke": "node scripts/sos-smoke.mjs",
    "test:outlands": "vitest run frontend/src/games/zombie-shooter",
    "test:outlands:smoke": "node scripts/outlands-smoke.mjs",
    "outlands:server": "node server/outlands/dev.js",
    "outlands:server:build": "node scripts/build-outlands-server.mjs",
    "outlands:server:run": "node node_modules/.cache/outlands-server.cjs",
    "preview": "vite preview",
    "cdk": "cdk",
    "deploy": "npx cdk deploy",
    "testnet:status": "node scripts/testnet-status.mjs",
    "sprites": "node scripts/sprite-gen.mjs",
    "sprites:copy": "node scripts/copy-sprites.mjs",
    "sprites:validate": "node scripts/validate-sprites.mjs",
    "sprites:gen": "node scripts/sprite-gen.mjs gen-set",
    "sprites:extract": "node scripts/sprite-gen.mjs extract",
    "sprites:compose": "node scripts/sprite-gen.mjs compose-atlas",
    "sprites:prepare": "node scripts/sprite-gen.mjs prepare",
    "build:sprites": "node scripts/copy-sprites.mjs && vite build",
    "sprites:pixellab": "node scripts/sprite-gen/pixellab.mjs"
  },
  "dependencies": {
    "@aws-cdk/aws-apigatewayv2-alpha": "^2.114.1-alpha.0",
    "@aws-cdk/aws-apigatewayv2-integrations-alpha": "^2.114.1-alpha.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.408.0",
    "@aws-sdk/client-dynamodb": "^3.408.0",
    "@aws-sdk/lib-dynamodb": "^3.408.0",
    "@cspotcode/source-map-support": "^0.8.1",
    "aws-cdk-lib": "^2.154.0",
    "constructs": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.32.0",
    "pixi.js": "^7.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
