# Copy to frontend/.env to override the deployed prod endpoints.
# Values below are the current defaults (already baked into the code as fallbacks),
# so you only need this file when pointing at a different stack.

# REST API Gateway URL (lib/casino-infra-stack.ts output `RestApiUrl`).
VITE_API_URL=https://pmeyof3qzi.execute-api.us-east-2.amazonaws.com/prod

# WebSocket lobby URL (stack output `WebSocketApiUrl`).
VITE_WEBSOCKET_URL=wss://vbgum6fbrg.execute-api.us-east-2.amazonaws.com/prod

# Optional authoritative Outlands sector (npm run outlands:server). When set, deployment
# connects to this authenticated shared room server (not the local browser simulation).
# The server must be publicly reachable over WSS in production and allow this site's origin.
# VITE_OUTLANDS_WS_URL=ws://127.0.0.1:3020/outlands

# Cognito Hosted UI domain + app client ID (public, not a secret).
VITE_COGNITO_DOMAIN=reimondev.auth.us-east-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=77ieg4fiv0dg7fo5g9uqb1n5rm

# OAuth callback. Defaults to `${window.location.origin}/oauth2/callback`;
# only needed if the callback differs from the deployed site URL.
# VITE_OAUTH_REDIRECT=https://casino888.netlify.app/oauth2/callback

# Fixed testnet only. No mainnet configuration exists in frontend code.
VITE_TESTNET_CHAIN_ID=84532
# Use sprite-atlas rendering (assets/sprites/generated + `npm run sprites:copy`
# -> frontend/public/sprites/<name>/). Off (unset) by default -> procedural art.
# Netlify deploys set this to 1 via netlify.toml [build.environment].
# VITE_USE_SPRITE_ATLAS=1
# Set only after audited contracts are deployed to Base Sepolia.
# VITE_C888T_ADDRESS=0x...
# VITE_C888_ESCROW_ADDRESS=0x...
# Subpath where the ReimonDev Games library is hosted (Netlify production).
VITE_BASE_PATH=/games/
