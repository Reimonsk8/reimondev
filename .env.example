# Cognito / Amplify Auth — required for the /login page.
# Copy this file to `.env.local` (dev) or set the same names in the
# AWS Amplify console (production). The dev server must be restarted after
# changing env vars.
#
# The portal shares the games app's user pool (us-east-2), so one sign-in
# works across the site and the multiplayer games.

# User pool ID — the only required value. Find it with:
#   aws cognito-idp list-user-pools --max-results 60 --region us-east-2
REACT_APP_AUTH_USER_POOL_ID=

# Optional overrides (defaults already match the deployed games app).
# REACT_APP_AUTH_REGION=us-east-2
# REACT_APP_AUTH_USER_POOL_CLIENT_ID=77ieg4fiv0dg7fo5g9uqb1n5rm
# REACT_APP_AUTH_COGNITO_DOMAIN=reimondev.auth.us-east-2.amazoncognito.com

# Allow-listed callback URLs for the app client:
#   http://localhost:3000/login   and   https://reimondev.com/login
#   (plus the games app's existing /games/oauth2/callback entries)
# Allow-listed sign-out URLs:
#   http://localhost:3000/        and   https://reimondev.com/
